### 5. Physicians earning more than 50000

```sql
SELECT *
FROM Physician
WHERE salary > 50000;
```

---

### 6. Unique areas of specialization

```sql
SELECT DISTINCT Field
FROM Physician_Speciality;
```

---

### 7. Physicians whose specialization length < 5

```sql
SELECT *
FROM Physician_Speciality
WHERE LENGTH(Field) < 5;
```

---

### 8. Physician names and monthly salary

```sql
SELECT Phy_fname, Phy_Lname, salary
FROM Physician;
```

---

### 9. Physicians whose first name has 5 letters

```sql
SELECT *
FROM Physician
WHERE LENGTH(Phy_fname) = 5;
```

---

### 10. Departments not starting with 'P'

```sql
SELECT Field
FROM Physician_Speciality
WHERE Field NOT LIKE 'P%';
```

---

### 11. All nurses with their shift

```sql
SELECT nurse_fname, nurse_Lname, shift
FROM Nurse;
```

---

### 12. Patients >60 treated by cardiologist

```sql
SELECT p.*
FROM Patient p
JOIN Physician_Speciality ps ON p.phy_id = ps.Phy_ID
WHERE p.Age > 60
AND ps.Field = 'Cardiology';
```

---

### 13. Ward names with more than 25 beds

```sql
SELECT ward_name
FROM Ward
WHERE No_of_beds > 25;
```

---

### 14. Names of admitted patients, physician name and ward name

```sql
SELECT p.pat_fname, ph.Phy_fname, w.ward_name
FROM Patient p
JOIN Physician ph ON p.phy_id = ph.Phy_ID
JOIN Ward w ON p.Ward_num = w.ward_no;
```

---

### 15. Doctors grouped by number of patients

```sql
SELECT ph.Phy_fname, COUNT(p.pat_ID) AS Total_Patients
FROM Physician ph
LEFT JOIN Patient p ON ph.Phy_ID = p.phy_id
GROUP BY ph.Phy_fname;
```

